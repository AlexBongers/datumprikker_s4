<%- include('partials/header', { pageTitle: 'Home' }) %>
<section class="hero-grid">
  <div class="hero-copy card-panel">
    <span class="eyebrow">Datumprikker</span>
    <h1>Eén rustige plek om samen een datum te kiezen.</h1>
    <p>Maak een event, deel links en kies daarna de beste optie.</p>
    <div class="hero-actions">
      <a href="/admin/login" class="primary-button">Open dashboard</a>
      <button type="button" class="secondary-button" data-help-toggle>Hoe werkt het?</button>
    </div>
    <div class="mini-stats">
      <span>Maak</span>
      <span>Deel</span>
      <span>Kies</span>
    </div>
  </div>
  <div class="hero-card card-panel">
    <h2>Heb je al een link?</h2>
    <form class="stack" onsubmit="event.preventDefault(); window.location.href = this.inviteLink.value.trim();">
      <label class="field-label" for="inviteLink">Plak je uitnodiging</label>
      <input id="inviteLink" name="inviteLink" class="text-input" placeholder="https://.../events/respond/..." />
      <button class="primary-button" type="submit">Open</button>
    </form>
    <div class="tip-box compact-tip">
      <strong>Lokaal</strong>
      <p>Geen hosting nodig. Gewoon op je laptop starten.</p>
    </div>
  </div>
</section>

<section class="content-grid tidy-grid">
  <article class="card-panel">
    <h3>Voor organisatoren</h3>
    <p>Nieuw event, datumopties, deelnemers.</p>
  </article>
  <article class="card-panel">
    <h3>Voor deelnemers</h3>
    <p>Eén link, snel reageren, later aanpassen.</p>
  </article>
  <article class="card-panel">
    <h3>Voor de keuze</h3>
    <p>De beste datum staat vanzelf bovenaan.</p>
  </article>
</section>
<%- include('partials/footer') %>
