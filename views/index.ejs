<%- include('partials/header', { pageTitle: 'Home' }) %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="text-center mb-5">
      <h1 class="display-5 fw-bold text-primary">
        <i class="bi bi-shield-check"></i> Cybercheck Datumprikker
      </h1>
      <p class="lead text-muted">
        Interviewplanning voor studenten &amp; ondernemers — Hogeschool Utrecht
      </p>
    </div>

    <div class="row g-4">
      <div class="col-md-6">
        <div class="card h-100 border-primary shadow-sm">
          <div class="card-body text-center p-4">
            <i class="bi bi-person-gear display-4 text-primary mb-3"></i>
            <h5 class="card-title">Beheerder</h5>
            <p class="card-text text-muted">
              Maak een nieuw interview-event aan en stel de beschikbare dagen en tijdstippen in.
            </p>
            <a href="/admin" class="btn btn-primary">
              <i class="bi bi-plus-circle"></i> Nieuw event aanmaken
            </a>
          </div>
        </div>
      </div>

      <div class="col-md-6">
        <div class="card h-100 border-success shadow-sm">
          <div class="card-body text-center p-4">
            <i class="bi bi-people-fill display-4 text-success mb-3"></i>
            <h5 class="card-title">Student / Ondernemer</h5>
            <p class="card-text text-muted">
              Je hebt een link ontvangen van de beheerder. Klik op de link om je beschikbaarheid aan te geven.
            </p>
            <div class="input-group mt-3">
              <input
                type="text"
                id="eventLinkInput"
                class="form-control"
                placeholder="Plak je event-link hier..."
              />
              <button class="btn btn-success" onclick="goToEvent()">
                <i class="bi bi-arrow-right"></i>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="card mt-4 border-0" style="background: linear-gradient(135deg, #eef1f6 0%, #e6edf7 100%);">
      <div class="card-body">
        <h6 class="card-title">
          <i class="bi bi-info-circle text-primary"></i> Hoe werkt het?
        </h6>
        <ol class="mb-0 text-muted small">
          <li>De <strong>beheerder</strong> maakt een event aan met beschikbare tijdsloten.</li>
          <li>De beheerder deelt aparte links met <strong>studenten</strong> en <strong>ondernemers</strong>.</li>
          <li>Iedereen klikt de momenten aan waarop ze beschikbaar zijn.</li>
          <li>Het systeem toont automatisch de <strong class="text-success">matches</strong> (overlappende beschikbaarheid).</li>
        </ol>
      </div>
    </div>
  </div>
</div>

<script>
  function goToEvent() {
    const val = document.getElementById('eventLinkInput').value.trim();
    if (val) window.location.href = val;
  }
</script>

<%- include('partials/footer') %>
