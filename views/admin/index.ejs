<%- include('../partials/header', { pageTitle: 'Nieuw event' }) %>
<section class="page-header-row">
  <div>
    <span class="eyebrow">Nieuw event</span>
    <h1>Nieuw event</h1>
  </div>
</section>

<% const formValues = values || {}; %>
<% if (error) { %><div class="alert-banner danger"><%= error %></div><% } %>
<form action="/admin/events" method="POST" class="stack-lg" id="eventForm">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

  <section class="card-panel form-section">
    <h2>1. Eventdetails</h2>
    <div class="form-grid">
      <label>
        <span class="field-label">Titel</span>
        <input class="text-input" name="title" required value="<%= formValues.title || '' %>" />
      </label>
      <label>
        <span class="field-label">Tijdzone</span>
        <input class="text-input" name="timezone" value="<%= formValues.timezone || 'Europe/Amsterdam' %>" />
      </label>
      <label class="full-width">
        <span class="field-label">Beschrijving</span>
        <textarea class="text-area" name="description"><%= formValues.description || '' %></textarea>
      </label>
      <label>
        <span class="field-label">Locatiemodus</span>
        <select class="text-input" name="location_mode">
          <option value="hybrid" <%= (formValues.location_mode || 'hybrid') === 'hybrid' ? 'selected' : '' %>>Hybride</option>
          <option value="online" <%= formValues.location_mode === 'online' ? 'selected' : '' %>>Online</option>
          <option value="onsite" <%= formValues.location_mode === 'onsite' ? 'selected' : '' %>>Op locatie</option>
        </select>
      </label>
      <label>
        <span class="field-label">Reactiedeadline</span>
        <input class="text-input" type="datetime-local" name="response_deadline" value="<%= formValues.response_deadline || '' %>" />
      </label>
      <label class="full-width">
        <span class="field-label">Locatie / extra instructie</span>
        <input class="text-input" name="location_details" value="<%= formValues.location_details || '' %>" placeholder="Bijv. MS Teams, lokaal 2.14 of ontvangstbalie" />
      </label>
    </div>
  </section>

  <section class="card-panel form-section">
    <div class="row-space">
      <h2>2. Datumopties</h2>
      <button type="button" class="secondary-button" data-add-row="slotRows">Optie toevoegen</button>
    </div>
    <div class="stack" id="slotRows">
      <div class="dynamic-row two-up">
        <input type="datetime-local" class="text-input" name="slots[]" required />
        <input type="datetime-local" class="text-input" name="slots_end[]" />
        <button type="button" class="ghost-button danger" data-remove-row>Verwijder</button>
      </div>
    </div>
  </section>

  <section class="card-panel form-section">
    <div class="row-space">
      <h2>3. Deelnemers</h2>
      <button type="button" class="secondary-button" data-add-row="inviteeRows">Deelnemer toevoegen</button>
    </div>
    <div class="stack" id="inviteeRows">
      <div class="dynamic-row invitee-row">
        <input class="text-input" name="invitee_name[]" placeholder="Naam" />
        <select class="text-input" name="invitee_role[]">
          <option value="student">Student</option>
          <option value="ondernemer">Ondernemer</option>
        </select>
        <input class="text-input" name="invitee_email[]" placeholder="E-mail (optioneel)" />
        <input class="text-input" name="invitee_phone[]" placeholder="Telefoon (optioneel)" />
        <input class="text-input" name="invitee_organization[]" placeholder="Organisatie / context" />
        <label class="checkbox-line"><input type="checkbox" name="invitee_required" value="" /> Verplicht voor beste match</label>
        <button type="button" class="ghost-button danger" data-remove-row>Verwijder</button>
      </div>
    </div>
  </section>

  <button class="primary-button" type="submit">Event aanmaken</button>
</form>

<script>
  window.datumprikkerCreateForm && window.datumprikkerCreateForm();
</script>
<%- include('../partials/footer') %>
