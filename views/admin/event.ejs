<%- include('../partials/header', { pageTitle: event.title }) %>

<div class="row justify-content-center">
  <div class="col-lg-10">

    <div class="d-flex justify-content-between align-items-start mb-4">
      <div>
        <h2 class="mb-1"><i class="bi bi-calendar-event text-primary"></i> <%= event.title %></h2>
        <% if (event.description) { %>
          <p class="text-muted mb-0"><%= event.description %></p>
        <% } %>
      </div>
      <span class="badge bg-primary fs-6">Beheerder</span>
    </div>

    <!-- Share links -->
    <div class="card shadow-sm mb-4">
      <div class="card-header bg-success text-white">
        <i class="bi bi-share"></i> Deel deze links
      </div>
      <div class="card-body">
        <p class="text-muted small mb-3">
          Stuur de juiste link naar studenten en ondernemers zodat zij hun beschikbaarheid kunnen invullen.
        </p>
        <div class="mb-3">
          <label class="form-label fw-semibold">
            <i class="bi bi-mortarboard text-info"></i> Link voor studenten
          </label>
          <div class="input-group">
            <input
              type="text"
              class="form-control font-monospace small"
              id="studentLink"
              value="<%= `${baseUrl}/events/${event.id}?type=student` %>"
              readonly
            />
            <button class="btn btn-outline-secondary" onclick="copyLink('studentLink')">
              <i class="bi bi-clipboard"></i>
            </button>
          </div>
        </div>
        <div>
          <label class="form-label fw-semibold">
            <i class="bi bi-briefcase text-warning"></i> Link voor ondernemers
          </label>
          <div class="input-group">
            <input
              type="text"
              class="form-control font-monospace small"
              id="ondernemerLink"
              value="<%= `${baseUrl}/events/${event.id}?type=ondernemer` %>"
              readonly
            />
            <button class="btn btn-outline-secondary" onclick="copyLink('ondernemerLink')">
              <i class="bi bi-clipboard"></i>
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- Overview table -->
    <div class="card shadow-sm">
      <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <span><i class="bi bi-table"></i> Beschikbaarheidsoverzicht</span>
        <span class="badge bg-light text-dark"><%= slots.length %> tijdsloten</span>
      </div>
      <div class="card-body p-0">
        <% if (slots.length === 0) { %>
          <p class="text-muted p-4 mb-0">Geen tijdsloten gevonden.</p>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-bordered mb-0 align-middle">
              <thead class="table-light">
                <tr>
                  <th>Tijdslot</th>
                  <th class="text-center"><i class="bi bi-mortarboard text-info"></i> Studenten</th>
                  <th class="text-center"><i class="bi bi-briefcase text-warning"></i> Ondernemers</th>
                  <th class="text-center"><i class="bi bi-arrow-left-right text-success"></i> Match</th>
                </tr>
              </thead>
              <tbody>
                <% for (const slot of slots) {
                  const sr = slotResponses[slot.id] || { students: [], ondernemers: [] };
                  const isMatch = sr.students.length > 0 && sr.ondernemers.length > 0;
                  const dt = new Date(slot.slot_datetime);
                %>
                <tr class="<%= isMatch ? 'table-success' : '' %>">
                  <td>
                    <strong><%= dt.toLocaleDateString('nl-NL', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></strong>
                    <br /><span class="text-muted"><%= dt.toLocaleTimeString('nl-NL', { hour: '2-digit', minute: '2-digit' }) %></span>
                  </td>
                  <td class="text-center">
                    <% if (sr.students.length === 0) { %>
                      <span class="text-muted small">—</span>
                    <% } else { %>
                      <% for (const name of sr.students) { %>
                        <span class="badge bg-info text-dark me-1"><%= name %></span>
                      <% } %>
                    <% } %>
                  </td>
                  <td class="text-center">
                    <% if (sr.ondernemers.length === 0) { %>
                      <span class="text-muted small">—</span>
                    <% } else { %>
                      <% for (const name of sr.ondernemers) { %>
                        <span class="badge bg-warning text-dark me-1"><%= name %></span>
                      <% } %>
                    <% } %>
                  </td>
                  <td class="text-center">
                    <% if (isMatch) { %>
                      <span class="badge bg-success"><i class="bi bi-check-circle"></i> Match!</span>
                    <% } else { %>
                      <span class="text-muted small">—</span>
                    <% } %>
                  </td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>

    <div class="mt-3 text-center">
      <a href="/admin" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-plus-circle"></i> Nieuw event aanmaken
      </a>
    </div>
  </div>
</div>

<script>
  function copyLink(id) {
    const input = document.getElementById(id);
    input.select();
    navigator.clipboard.writeText(input.value).then(() => {
      const btn = input.nextElementSibling;
      btn.innerHTML = '<i class="bi bi-check"></i>';
      setTimeout(() => { btn.innerHTML = '<i class="bi bi-clipboard"></i>'; }, 2000);
    });
  }
</script>

<%- include('../partials/footer') %>
