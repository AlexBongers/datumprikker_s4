<%- include('../partials/header', { pageTitle: event.title }) %>

<div class="row justify-content-center">
  <div class="col-lg-10">

    <div class="d-flex justify-content-between align-items-start mb-4">
      <div>
        <h2 class="mb-1"><i class="bi bi-calendar-event text-primary"></i> <%= event.title %></h2>
        <% if (event.description) { %>
          <p class="text-muted mb-0"><%= event.description %></p>
        <% } %>
      </div>
      <div class="d-flex gap-2 flex-wrap justify-content-end">
        <span class="badge bg-primary fs-6 align-self-start">Beheerder</span>
        <a href="/admin/events/<%= event.id %>/edit?token=<%= token %>" class="btn btn-outline-secondary btn-sm">
          <i class="bi bi-pencil"></i> Aanpassen
        </a>
        <form
          action="/admin/events/<%= event.id %>/delete"
          method="POST"
          class="d-inline"
          id="deleteEventForm"
          data-title="<%= event.title %>"
        >
          <input type="hidden" name="token" value="<%= token %>" />
          <input type="hidden" name="_csrf" value="<%= csrfToken %>" />
          <button type="submit" class="btn btn-outline-danger btn-sm">
            <i class="bi bi-trash"></i> Verwijderen
          </button>
        </form>
      </div>
    </div>


    <!-- Share links -->
    <div class="card shadow-sm mb-4">
      <div class="card-header bg-success text-white d-flex justify-content-between align-items-center">
        <span><i class="bi bi-share"></i> Deel deze links</span>
        <button class="btn btn-sm btn-link text-white p-0 text-decoration-none" type="button"
          data-bs-toggle="collapse" data-bs-target="#shareLinks">
          <i class="bi bi-chevron-down"></i>
        </button>
      </div>
      <div class="collapse show" id="shareLinks">
        <div class="card-body">
          <p class="text-muted small mb-3">
            Stuur de juiste link naar studenten en ondernemers zodat zij hun beschikbaarheid kunnen invullen.
          </p>
          <div class="mb-3">
            <label class="form-label fw-semibold">
              <i class="bi bi-mortarboard text-info"></i> Link voor studenten
            </label>
            <div class="input-group">
              <input
                type="text"
                class="form-control font-monospace small"
                id="studentLink"
                value="<%= `${baseUrl}/events/${event.id}?type=student` %>"
                readonly
              />
              <button class="btn btn-outline-secondary" onclick="copyLink('studentLink')" title="Kopieer link">
                <i class="bi bi-clipboard"></i>
              </button>
            </div>
          </div>
          <div class="mb-3">
            <label class="form-label fw-semibold">
              <i class="bi bi-briefcase text-warning"></i> Link voor ondernemers
            </label>
            <div class="input-group">
              <input
                type="text"
                class="form-control font-monospace small"
                id="ondernemerLink"
                value="<%= `${baseUrl}/events/${event.id}?type=ondernemer` %>"
                readonly
              />
              <button class="btn btn-outline-secondary" onclick="copyLink('ondernemerLink')" title="Kopieer link">
                <i class="bi bi-clipboard"></i>
              </button>
            </div>
          </div>
          <div>
            <label class="form-label fw-semibold">
              <i class="bi bi-shield-lock text-primary"></i> Beheerderslink (privé — niet delen)
            </label>
            <div class="input-group">
              <input
                type="text"
                class="form-control font-monospace small"
                id="adminLink"
                value="<%= `${baseUrl}/admin/events/${event.id}?token=${token}` %>"
                readonly
              />
              <button class="btn btn-outline-secondary" onclick="copyLink('adminLink')" title="Kopieer beheerderslink">
                <i class="bi bi-clipboard"></i>
              </button>
            </div>
            <div class="form-text text-warning">
              <i class="bi bi-exclamation-triangle"></i> Bewaar deze link! Zonder dit token kun je het event niet meer beheren.
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Overview table -->
    <div class="card shadow-sm">
      <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <span><i class="bi bi-table"></i> Beschikbaarheidsoverzicht</span>
        <span class="badge bg-light text-dark"><%= slots.length %> tijdsloten</span>
      </div>
      <div class="card-body p-0">
        <% if (slots.length === 0) { %>
          <p class="text-muted p-4 mb-0">Geen tijdsloten gevonden.</p>
        <% } else { %>
          <div class="table-responsive">
            <table class="table table-bordered mb-0 align-middle">
              <thead class="table-light">
                <tr>
                  <th>Tijdslot</th>
                  <th class="text-center"><i class="bi bi-mortarboard text-info"></i> Studenten</th>
                  <th class="text-center"><i class="bi bi-briefcase text-warning"></i> Ondernemers</th>
                  <th class="text-center"><i class="bi bi-arrow-left-right text-success"></i> Match</th>
                </tr>
              </thead>
              <tbody>
                 <% for (const slot of slots) {
                  const sr = slotResponses[slot.id] || { students: [], ondernemers: [] };
                  const isMatch = sr.students.length > 0 && sr.ondernemers.length > 0;
                  const dt = new Date(slot.slot_datetime);
                  const dtEnd = slot.slot_end_datetime ? new Date(slot.slot_end_datetime) : null;
                %>
                <tr class="<%= isMatch ? 'table-success' : '' %>">
                  <td>
                    <strong><%= dt.toLocaleDateString('nl-NL', { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' }) %></strong>
                    <br /><span class="text-muted">
                      <%= dt.toLocaleTimeString('nl-NL', { hour: '2-digit', minute: '2-digit' }) %>
                      <% if (dtEnd) { %>&ndash;<%= dtEnd.toLocaleTimeString('nl-NL', { hour: '2-digit', minute: '2-digit' }) %><% } %>
                    </span>
                  </td>
                  <td class="text-center">
                    <% if (sr.students.length === 0) { %>
                      <span class="text-muted small">—</span>
                    <% } else { %>
                      <% for (const s of sr.students) { %>
                        <span class="badge bg-info text-dark me-1 mb-1"><%= s.name %></span>
                      <% } %>
                    <% } %>
                  </td>
                  <td class="text-center">
                    <% if (sr.ondernemers.length === 0) { %>
                      <span class="text-muted small">—</span>
                    <% } else { %>
                      <% for (const o of sr.ondernemers) { %>
                        <div class="mb-1">
                          <span class="badge bg-warning text-dark"><%= o.name %></span>
                          <% if (o.contactName || o.email || o.phone || o.location) { %>
                            <div class="text-muted" style="font-size:0.72rem; line-height:1.4;">
                              <% if (o.contactName) { %><i class="bi bi-person"></i> <%= o.contactName %><br /><% } %>
                              <% if (o.email) { %><a href="mailto:<%= o.email %>" class="text-reset"><i class="bi bi-envelope"></i> <%= o.email %></a><br /><% } %>
                              <% if (o.phone) { %><a href="tel:<%= o.phone %>" class="text-reset"><i class="bi bi-telephone"></i> <%= o.phone %></a><br /><% } %>
                              <% if (o.location) { %><i class="bi bi-geo-alt"></i> <%= o.location %><% } %>
                            </div>
                          <% } %>
                        </div>
                      <% } %>
                    <% } %>
                  </td>
                  <td class="text-center">
                    <% if (isMatch) { %>
                      <span class="badge bg-success"><i class="bi bi-check-circle"></i> Match!</span>
                    <% } else { %>
                      <span class="text-muted small">—</span>
                    <% } %>
                  </td>
                </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>

    <div class="mt-3 text-center">
      <a href="/admin/dashboard" class="btn btn-outline-secondary btn-sm me-2">
        <i class="bi bi-speedometer2"></i> Dashboard
      </a>
      <a href="/admin" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-plus-circle"></i> Nieuw event aanmaken
      </a>
    </div>
  </div>
</div>

<script>
  // ── Copy link utility ────────────────────────────────────────────────────
  function copyLink(id) {
    const input = document.getElementById(id);
    input.select();
    navigator.clipboard.writeText(input.value).then(() => {
      const btn = input.nextElementSibling;
      const orig = btn.innerHTML;
      btn.innerHTML = '<i class="bi bi-check text-success"></i>';
      setTimeout(() => { btn.innerHTML = orig; }, 2000);
    });
  }

  // ── Delete event confirmation ────────────────────────────────────────────
  document.getElementById('deleteEventForm').addEventListener('submit', function (e) {
    const title = this.dataset.title || 'dit event';
    if (!confirm('Event "' + title + '" definitief verwijderen? Dit kan niet ongedaan worden gemaakt.')) {
      e.preventDefault();
    }
  });
</script>

<%- include('../partials/footer') %>
