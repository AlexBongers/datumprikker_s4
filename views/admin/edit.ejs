<%- include('../partials/header', { pageTitle: 'Event aanpassen' }) %>

<div class="row justify-content-center">
  <div class="col-lg-8">
    <div class="d-flex justify-content-between align-items-start mb-1">
      <h2 class="mb-0"><i class="bi bi-pencil-square text-primary"></i> Event aanpassen</h2>
      <a href="/admin/events/<%= event.id %>?token=<%= token %>" class="btn btn-outline-secondary btn-sm">
        <i class="bi bi-arrow-left"></i> Terug
      </a>
    </div>
    <p class="text-muted mb-4">Pas de titel, beschrijving of tijdsloten aan.</p>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert alert-danger"><i class="bi bi-exclamation-triangle"></i> <%= error %></div>
    <% } %>

    <form action="/admin/events/<%= event.id %>/edit" method="POST" id="editForm">
      <input type="hidden" name="token" value="<%= token %>" />
      <input type="hidden" name="_csrf" value="<%= csrfToken %>" />

      <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
          <i class="bi bi-info-circle"></i> Event informatie
        </div>
        <div class="card-body">
          <div class="mb-3">
            <label for="title" class="form-label fw-semibold">Titel <span class="text-danger">*</span></label>
            <input
              type="text"
              class="form-control"
              id="title"
              name="title"
              value="<%= event.title %>"
              required
            />
          </div>
          <div class="mb-3">
            <label for="description" class="form-label fw-semibold">Beschrijving</label>
            <textarea
              class="form-control"
              id="description"
              name="description"
              rows="2"
            ><%= event.description || '' %></textarea>
          </div>
        </div>
      </div>

      <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
          <i class="bi bi-lightning-charge"></i> Snelle toevoeging — 24 &amp; 25 maart 2026
        </div>
        <div class="card-body">
          <p class="text-muted small mb-3">
            Vink uurblokken aan om ze toe te voegen aan de tijdsloten hieronder.
          </p>

          <% const prefabDays = [
            { label: 'Maandag 24 maart 2026', date: '2026-03-24' },
            { label: 'Dinsdag 25 maart 2026', date: '2026-03-25' },
          ]; %>

          <% for (const day of prefabDays) { %>
          <div class="mb-3">
            <div class="d-flex justify-content-between align-items-center mb-2">
              <span class="fw-semibold"><%= day.label %></span>
              <button type="button" class="btn btn-link btn-sm p-0 toggle-day text-decoration-none" data-date="<%= day.date %>">
                Alles selecteren
              </button>
            </div>
            <div class="d-flex flex-wrap gap-2">
              <% for (let h = 10; h < 16; h++) {
                const startH = String(h).padStart(2, '0');
                const endH   = String(h + 1).padStart(2, '0');
                const startVal = day.date + 'T' + startH + ':00';
                const endVal   = day.date + 'T' + endH   + ':00';
                const cbId     = 'prefab_' + day.date + '_' + startH;
              %>
              <div class="form-check form-check-inline border rounded px-3 py-2 prefab-slot-option">
                <input
                  class="form-check-input prefab-slot"
                  type="checkbox"
                  id="<%= cbId %>"
                  data-start="<%= startVal %>"
                  data-end="<%= endVal %>"
                />
                <label class="form-check-label user-select-none" for="<%= cbId %>">
                  <%= startH %>:00 &ndash; <%= endH %>:00
                </label>
              </div>
              <% } %>
            </div>
          </div>
          <% } %>

          <div class="alert alert-info py-2 small mb-0">
            <i class="bi bi-info-circle"></i>
            Geselecteerde uurblokken worden toegevoegd aan de handmatige tijdsloten hieronder bij het opslaan.
          </div>
        </div>
      </div>

      <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
          <i class="bi bi-clock"></i> Tijdsloten
        </div>
        <div class="card-body">
          <p class="text-muted small mb-3">
            Pas de beschikbare interview-momenten aan. Bestaande reacties op verwijderde slots worden mee verwijderd.
          </p>

          <div id="slotsContainer">
            <% for (const slot of slots) {
              const startVal = slot.slot_datetime ? slot.slot_datetime.slice(0, 16) : '';
              const endVal   = slot.slot_end_datetime ? slot.slot_end_datetime.slice(0, 16) : '';
            %>
            <div class="slot-row row g-2 mb-2 align-items-center">
              <div class="col-sm-5">
                <label class="form-label form-label-sm text-muted mb-1">Begintijd <span class="text-danger">*</span></label>
                <input
                  type="datetime-local"
                  class="form-control"
                  name="slots[]"
                  value="<%= startVal %>"
                  required
                />
              </div>
              <div class="col-sm-5">
                <label class="form-label form-label-sm text-muted mb-1">Eindtijd</label>
                <input
                  type="datetime-local"
                  class="form-control"
                  name="slots_end[]"
                  value="<%= endVal %>"
                />
              </div>
              <div class="col-sm-auto mt-sm-4">
                <button type="button" class="btn btn-outline-danger btn-sm remove-slot" <%= slots.length === 1 ? 'disabled' : '' %>>
                  <i class="bi bi-trash"></i>
                </button>
              </div>
            </div>
            <% } %>
          </div>

          <button type="button" class="btn btn-outline-primary btn-sm mt-2" id="addSlot">
            <i class="bi bi-plus-circle"></i> Tijdslot toevoegen
          </button>
        </div>
      </div>

      <div class="d-grid gap-2 d-sm-flex justify-content-sm-end">
        <a href="/admin/events/<%= event.id %>?token=<%= token %>" class="btn btn-outline-secondary">
          Annuleren
        </a>
        <button type="submit" class="btn btn-primary">
          <i class="bi bi-check-circle"></i> Wijzigingen opslaan
        </button>
      </div>
    </form>
  </div>
</div>

<script>
  // ── Manual slot add/remove ───────────────────────────────────────────────
  document.getElementById('addSlot').addEventListener('click', function () {
    const container = document.getElementById('slotsContainer');
    const row = document.createElement('div');
    row.className = 'slot-row row g-2 mb-2 align-items-center';
    row.innerHTML = `
      <div class="col-sm-5">
        <label class="form-label form-label-sm text-muted mb-1">Begintijd <span class="text-danger">*</span></label>
        <input type="datetime-local" class="form-control" name="slots[]" required />
      </div>
      <div class="col-sm-5">
        <label class="form-label form-label-sm text-muted mb-1">Eindtijd</label>
        <input type="datetime-local" class="form-control" name="slots_end[]" />
      </div>
      <div class="col-sm-auto mt-sm-4">
        <button type="button" class="btn btn-outline-danger btn-sm remove-slot">
          <i class="bi bi-trash"></i>
        </button>
      </div>
    `;
    container.appendChild(row);
    updateRemoveButtons();
  });

  document.getElementById('slotsContainer').addEventListener('click', function (e) {
    if (e.target.closest('.remove-slot')) {
      e.target.closest('.slot-row').remove();
      updateRemoveButtons();
    }
  });

  function updateRemoveButtons() {
    const rows = document.querySelectorAll('.slot-row');
    rows.forEach((row) => {
      const btn = row.querySelector('.remove-slot');
      btn.disabled = rows.length === 1;
    });
  }

  // ── Per-day "Alles selecteren" toggle ───────────────────────────────────
  document.querySelectorAll('.toggle-day').forEach(function (btn) {
    btn.addEventListener('click', function () {
      const date = btn.dataset.date;
      const checkboxes = document.querySelectorAll('.prefab-slot[data-start^="' + date + '"]');
      const allChecked = Array.from(checkboxes).every((cb) => cb.checked);
      checkboxes.forEach((cb) => { cb.checked = !allChecked; });
      btn.textContent = allChecked ? 'Alles selecteren' : 'Alles deselecteren';
    });
  });

  document.querySelectorAll('.prefab-slot').forEach(function (cb) {
    cb.addEventListener('change', function () {
      const date = cb.dataset.start.slice(0, 10);
      const btn = document.querySelector('.toggle-day[data-date="' + date + '"]');
      if (!btn) return;
      const siblings = document.querySelectorAll('.prefab-slot[data-start^="' + date + '"]');
      const allChecked = Array.from(siblings).every((s) => s.checked);
      btn.textContent = allChecked ? 'Alles deselecteren' : 'Alles selecteren';
    });
  });

  // ── Inject prefab slots as hidden fields on submit ───────────────────────
  document.getElementById('editForm').addEventListener('submit', function (e) {
    const checkedPrefabs = document.querySelectorAll('.prefab-slot:checked');
    checkedPrefabs.forEach(function (cb) {
      const hiddenStart = document.createElement('input');
      hiddenStart.type  = 'hidden';
      hiddenStart.name  = 'slots[]';
      hiddenStart.value = cb.dataset.start;

      const hiddenEnd = document.createElement('input');
      hiddenEnd.type  = 'hidden';
      hiddenEnd.name  = 'slots_end[]';
      hiddenEnd.value = cb.dataset.end;

      document.getElementById('editForm').appendChild(hiddenStart);
      document.getElementById('editForm').appendChild(hiddenEnd);
    });
  });
</script>

<%- include('../partials/footer') %>
