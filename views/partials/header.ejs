<!DOCTYPE html>
<html lang="nl">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle + ' | ' : '' %>Cybercheck Datumprikker</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" />
  <link rel="stylesheet" href="/css/style.css" />
</head>
<body>
  <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
    <div class="container">
      <a class="navbar-brand" href="/">
        <i class="bi bi-shield-check"></i> Cybercheck Datumprikker
        <span class="hu-badge">HU</span>
      </a>
      <div class="ms-auto d-flex gap-2">
        <% if (typeof isAdmin !== 'undefined' && isAdmin) { %>
          <a class="btn btn-outline-light btn-sm" href="/admin/dashboard">
            <i class="bi bi-speedometer2"></i> Dashboard
          </a>
          <a class="btn btn-outline-light btn-sm" href="/admin">
            <i class="bi bi-plus-circle"></i> Nieuw event
          </a>
          <form action="/admin/logout" method="POST" class="d-inline">
            <button type="submit" class="btn btn-outline-light btn-sm">
              <i class="bi bi-box-arrow-right"></i> Uitloggen
            </button>
          </form>
        <% } else { %>
          <a class="btn btn-outline-light btn-sm" href="/admin/login">
            <i class="bi bi-shield-lock"></i> Beheerder
          </a>
        <% } %>
      </div>
    </div>
  </nav>

  <!-- Hero banner -->
  <div class="hu-hero">
    <div class="container">
      <p class="hero-title">
        <span class="hero-check">✓</span> Cybercheck — interview planning
      </p>
      <p class="hero-sub">Koppel studenten &amp; ondernemers aan de juiste interviewmomenten</p>
    </div>
  </div>

  <main class="container py-4">
