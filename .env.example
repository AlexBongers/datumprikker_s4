# Copy this file to .env and fill in the values for local development.
# Do NOT commit the .env file — it is already listed in .gitignore.

# ─── Server ──────────────────────────────────────────────────────────────────

# Port the Express server listens on (default: 3000)
PORT=3000

# Set to "production" when deploying
NODE_ENV=development

# ─── Session ─────────────────────────────────────────────────────────────────

# Long random string used to sign session cookies.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string

# ─── Database ────────────────────────────────────────────────────────────────

# Absolute path to the SQLite database file.
# Defaults to <repo-root>/data/datumprikker.db when not set.
# In production, point this at the mount path of your persistent volume.
DATABASE_PATH=/data/datumprikker.db

# ─── Admin dashboard ─────────────────────────────────────────────────────────

# Password to log in to the admin dashboard (/admin/login).
# Defaults to "admin" when not set — ALWAYS change this in production!
ADMIN_PASSWORD=change-me-to-a-secure-password


# Public base URL of the app (no trailing slash).
# Used to generate the shareable student/entrepreneur links on the admin page.
# Example: https://datumprikker.onrender.com
BASE_URL=http://localhost:3000
